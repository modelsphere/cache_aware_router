#!/bin/bash

CURRENT_LIMIT=$(ulimit -n)
if [ "$CURRENT_LIMIT" -lt 65535 ]; then
    echo "Error: ulimit -n $CURRENT_LIMIT is too low (minimum 65535 required)"
    exit 1
fi

date
cat /proc/cpuinfo | tail -n 50
export
date

# 有参数就透传(chart 传 `-c 底稿 -c 覆盖层 ...`),没参数维持单文件默认。
if [ "$#" -gt 0 ]; then
    exec ./cache-aware-router "$@"
else
    exec ./cache-aware-router -c configs/config.yaml
fi
